{
  "name": "phenyxpro-intel-feed",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create phenyxpro-intel-db",
    "db:migrate:local": "wrangler d1 migrations apply phenyxpro-intel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply phenyxpro-intel-db --remote",
    "check": "node --check src/index.js && node tests/smoke.mjs && node tests/media_sources.mjs && python3 tests/migration_smoke.py"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
